<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Wörkshop{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Logiciel de gestion pour garages automobiles. Digitalisez vos processus et améliorez votre productivité.{% endblock %}">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">

    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body class="bg-page-bg text-slate-900 font-sans">
    {% block body %}{% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</body>
</html>
